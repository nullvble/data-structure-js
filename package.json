{
  "name": "ds-kit-js",
  "version": "1.0.0",
  "description": "Typed data structures missing from JavaScript: Queue, Deque, BST, AVL, Red-Black tree, Heap, Trie, Graph, LRU, Bloom filter and more",
  "keywords": [
    "data-structures",
    "algorithms",
    "typescript",
    "queue",
    "deque",
    "stack",
    "linked-list",
    "bst",
    "avl",
    "red-black-tree",
    "skip-list",
    "heap",
    "priority-queue",
    "trie",
    "segment-tree",
    "fenwick-tree",
    "bloom-filter",
    "bitset",
    "union-find",
    "lru-cache",
    "graph",
    "dijkstra"
  ],
  "license": "MIT",
  "author": "nullvble",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nullvble/data-structure-js.git"
  },
  "homepage": "https://nullvble.github.io/data-structure-js/",
  "bugs": {
    "url": "https://github.com/nullvble/data-structure-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p .",
    "test": "tsx --test test/*.test.ts",
    "test:dist": "node scripts/smoke-test.mjs",
    "docs": "typedoc",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run test:dist"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  }
}
